# Copy this file to .env and fill in your key. Never commit .env.

# Required: web search (https://tavily.com)
TAVILY_API_KEY=

# Local model served by Ollama
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_NUM_CTX=8192
# OLLAMA_TIMEOUT=180

# Search (advanced depth costs 2 Tavily credits per search)
# SEARCH_DEPTH=advanced
# USE_PAGE_TEXT=true
# MAX_SOURCES=12

# Agent behaviour
# MIN_FINDINGS_PER_THEME=2
# MAX_FOLLOWUP_ROUNDS=1      # 0 turns the follow-up searches off
# ENABLE_WRITER=true         # false lists verified findings without synthesis

# Storage
# DATABASE_PATH=data/runs.db
# VERIFICATION_DB=data/verification_checkpoints.db